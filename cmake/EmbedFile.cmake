# ragtime_embed_file(<input> <header> <name>): writes <header> declaring
# `static const unsigned char <name>[]` with the bytes of <input>, so a small
# file (the window icon) can be built into the program. CMake re-runs and
# rewrites the header when <input> changes.
function(ragtime_embed_file input header name)
    file(READ ${input} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    " bytes "${bytes}")
    get_filename_component(source ${input} NAME)
    file(WRITE ${header}.tmp
        "// Generated by CMake from ${source}. Edit that file, never this one.\n"
        "#pragma once\n\n"
        "static const unsigned char ${name}[] = {\n    ${bytes}\n};\n")
    configure_file(${header}.tmp ${header} COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input})
endfunction()
